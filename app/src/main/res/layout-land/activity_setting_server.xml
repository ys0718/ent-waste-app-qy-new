<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_login"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <include layout="@layout/view_toolbar_new" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/x20">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="配置服务器信息" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="@dimen/x40"
            android:layout_weight="2"
            android:background="@mipmap/bg_login_psw"
            android:padding="@dimen/x20"
            app:cardCornerRadius="@dimen/x5">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="@dimen/x50"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/x40"
                    android:layout_marginVertical="@dimen/x20"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/x10"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/x20"
                            android:orientation="horizontal">


                            <TextView
                                style="@style/FormTitleStyle"
                                android:layout_width="wrap_content"
                                android:text="IP地址:   " />


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@mipmap/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_ip"
                                    style="@style/EditTextStyle3"
                                    android:imeOptions="actionNext"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:hint="请输入IP地址" />

                            </LinearLayout>

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/x10"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/FormTitleStyle"

                                    android:layout_width="wrap_content"
                                    android:text="端口号：" />


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@mipmap/bg_edittext"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_port"
                                        style="@style/EditTextStyle3"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:hint="请输入端口号"
                                        android:inputType="number" />

                                </LinearLayout>

                            </LinearLayout>


                            <LinearLayout
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:gravity="right"
                                android:layout_gravity="right|center"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/FormTitleStyle"
                                    android:layout_width="wrap_content"
                                    android:text="传输协议：" />


                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:gravity="center"
                                    android:layout_marginHorizontal="@dimen/x20"
                                    android:id="@+id/ll_htttp"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:id="@+id/iv_http"
                                        android:src="@mipmap/ic_selected"
                                        android:layout_width="@dimen/x24"
                                        android:layout_height="@dimen/x24"/>

                                    <TextView
                                        android:text="HTTP"
                                        style="@style/Font15Style"
                                        android:textColor="@color/white"
                                        />

                                </LinearLayout>

                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:gravity="center"
                                    android:id="@+id/ll_htttps"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:id="@+id/iv_https"
                                        android:src="@mipmap/ic_unselected"
                                        android:layout_width="@dimen/x24"
                                        android:layout_height="@dimen/x24"/>

                                    <TextView
                                        android:text="HTTPS"
                                        style="@style/Font15Style"
                                        android:textColor="@color/white"
                                        />

                                </LinearLayout>



                            </LinearLayout>


                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:layout_marginBottom="@dimen/x20"
                    android:gravity="center|center_horizontal"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="@dimen/x40"
                        android:layout_height="@dimen/x40"
                        android:layout_gravity="center_horizontal">


                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/x5"
                            android:src="@mipmap/ic_network_check" />

                        <ImageView
                            android:id="@+id/iv_server_loading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/ic_network_check3" />


                    </RelativeLayout>

                    <!--<com.grkj.ytjqy_pad.utils.view.BoldTextView
                        android:id="@+id/tv_server_info"
                        style="@style/Font12BlueStyle"
                        android:layout_marginTop="@dimen/x10"
                        android:text="服务器检测"
                        android:textSize="@dimen/x15" />-->

                    <LinearLayout
                        android:id="@+id/ll_server_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_server_info"
                            style="@style/Font122BlueStyle"
                            android:layout_marginRight="@dimen/x40"
                            android:layout_marginLeft="@dimen/x20"
                            android:textSize="@dimen/x14" />

                        <ImageView
                            android:id="@+id/iv_ser"
                            android:layout_width="@dimen/x20"
                            android:layout_height="@dimen/x20"
                            android:layout_marginLeft="@dimen/x1" />


                        <TextView
                            android:id="@+id/tv_ser"
                            style="@style/Font122BlueStyle"
                            android:layout_marginHorizontal="@dimen/x5"
                            android:textColor="@color/color_yellow" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingHorizontal="@dimen/x50"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_test"
                        android:layout_width="@dimen/x160"
                        android:layout_height="@dimen/x32"
                        android:layout_weight="1"
                        android:background="@drawable/button_style1"
                        android:text="测试连接"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x13" />

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="@dimen/x160"
                        android:layout_height="@dimen/x32"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/x20"
                        android:background="@drawable/button_style2"
                        android:text="保存并登录"
                        android:layout_weight="1"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x13" />
                </LinearLayout>


            </LinearLayout>



        </FrameLayout>



    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:background="@mipmap/bg_logo_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x30"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_back"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style1"
                android:layout_marginRight="@dimen/x20"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_back_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="返回" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>
    </RelativeLayout>


</LinearLayout>

