<?xml version="1.0" encoding="utf-8"?>


    <LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/ll_weight"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:padding="@dimen/x10"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:paddingHorizontal="@dimen/x20"
            android:layout_weight="1.3"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginTop="@dimen/x5"
            android:paddingVertical="@dimen/x10"
            android:background="@mipmap/bg_weight1"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/x40"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:src="@mipmap/ic_weight1" />


            <LinearLayout
                android:layout_width="@dimen/x120"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:padding="@dimen/x5"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/x10"
                android:gravity="center"
                android:orientation="vertical">

                <com.grkj.ytjqy_pad.utils.view.BoldTextView
                    android:id="@+id/tv_weight1"
                    style="@style/Font24Style"
                    android:layout_marginBottom="@dimen/x5"
                    android:background="@mipmap/bg_edittext"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="@dimen/x5"
                    android:paddingVertical="@dimen/x2"
                    android:text="0.000" />

                <TextView
                    style="@style/Font12BlueStyle"
                    android:layout_gravity="left"
                    android:gravity="left"
                    android:text="废物净重(kg)"
                    android:textSize="@dimen/x13" />

            </LinearLayout>

        </RelativeLayout>


        <LinearLayout
            android:background="@mipmap/bg_weight3"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/x10"
            android:layout_width="0dp"
            android:padding="@dimen/x10"
            android:layout_marginTop="@dimen/x5"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/x40"
                android:layout_margin="@dimen/x10"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:src="@mipmap/ic_weight2" />

            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/x5"
                android:layout_marginRight="@dimen/x10"
                android:layout_width="@dimen/x120"
                android:layout_height="wrap_content">

                <com.grkj.ytjqy_pad.utils.view.BoldTextView
                    android:text="0.000"
                    android:id="@+id/tv_weight2"
                    android:layout_marginBottom="@dimen/x5"
                    android:paddingHorizontal="@dimen/x5"
                    android:inputType="numberDecimal"
                    android:paddingVertical="@dimen/x2"
                    android:background="@mipmap/bg_edittext"
                    style="@style/Font24Style"/>

                <TextView
                    android:gravity="left"
                    android:layout_gravity="left"
                    style="@style/Font12BlueStyle"
                    android:textSize="@dimen/x13"
                    android:text="毛重(kg)" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:background="@mipmap/bg_weight3"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginTop="@dimen/x5"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/x40"
                android:layout_margin="@dimen/x10"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:src="@mipmap/ic_weight3" />

            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/x5"
                android:layout_marginRight="@dimen/x10"
                android:layout_width="@dimen/x120"
                android:layout_height="wrap_content">

                <EditText
                    android:hint="0.000"
                    android:id="@+id/tv_weight3"
                    android:layout_marginBottom="@dimen/x5"
                    android:paddingHorizontal="@dimen/x5"
                    android:paddingVertical="@dimen/x2"
                    android:inputType="numberDecimal"
                    android:background="@mipmap/bg_edittext"
                    style="@style/Font24Style"/>

                <TextView
                    android:gravity="left"
                    android:layout_gravity="left"
                    style="@style/Font12BlueStyle"
                    android:textSize="@dimen/x13"
                    android:text="皮重(kg)" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_select_blt"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="@dimen/x5"
                android:layout_weight="1"
                android:padding="@dimen/x5"
                android:background="@drawable/button_style2"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_weight" />

                <TextView
                    style="@style/Font10Style"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="蓝牙称连接" />

            </LinearLayout>



            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_weight="1.2"
                android:layout_height="0dp">

                <LinearLayout
                    android:id="@+id/ll_clear"
                    android:layout_width="0dp"
                    android:padding="@dimen/x5"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/x5"
                    android:layout_weight="1"
                    android:background="@drawable/button_style3"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:src="@mipmap/ic_clear_white" />

                    <TextView
                        style="@style/Font10Style"
                        android:layout_marginLeft="@dimen/x5"
                        android:padding="0dp"
                        android:text="清零" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_qp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/x5"
                    android:layout_weight="1"
                    android:background="@drawable/button_style1"
                    android:padding="@dimen/x5"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:src="@mipmap/ic_qp_white" />

                    <TextView
                        style="@style/Font10Style"
                        android:layout_marginLeft="@dimen/x5"
                        android:padding="0dp"
                        android:text="去皮" />

                </LinearLayout>


            </LinearLayout>



        </LinearLayout>

    </LinearLayout>
