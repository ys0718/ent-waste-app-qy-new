<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/x100"
    android:layout_marginRight="@dimen/x100"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/frame"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x50"
            android:background="@color/colorPrimary"
            android:gravity="center"
            android:text="标题"
            android:textColor="#ffffff"
            android:textSize="@dimen/x20" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/line_color" />

        <LinearLayout
            android:id="@+id/userName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x210"
            android:background="@android:color/transparent"
            android:gravity="center">

            <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
                android:layout_margin="@dimen/x10"
                android:overScrollMode="never"
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/line_color" />


        <LinearLayout
            android:id="@+id/mBottomLayout"
            android:layout_width="match_parent"
            android:layout_gravity="bottom"
            android:layout_height="@dimen/x50"
            android:paddingTop="@dimen/x5"
            android:paddingBottom="@dimen/x5"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/negativeButton"
                android:width="0dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="@dimen/x40"
                android:layout_gravity="center"
                android:layout_margin="@dimen/x20"
                android:background="@drawable/button_style_gray"
                android:text="取消"
                android:textColor="#ededed" />

            <View
                android:layout_width="@dimen/x1"
                android:layout_height="match_parent"
                android:background="@color/line_color"/>

            <Button
                android:id="@+id/positiveButton"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_margin="@dimen/x20"
                android:layout_height="@dimen/x40"
                android:layout_gravity="center"
                android:background="@drawable/button_style_primary"
                android:text="确定"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>