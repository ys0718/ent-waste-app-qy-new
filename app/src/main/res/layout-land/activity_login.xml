<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_login"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/x10"
        android:gravity="left|center"
        android:orientation="horizontal"
        android:padding="@dimen/x20">

        <ImageView
            android:id="@+id/login_logo_iv"
            android:layout_width="@dimen/x70"
            android:layout_height="@dimen/x70"
            android:src="@mipmap/ic_login_top_logo2" />

        <ImageView
            android:layout_width="@dimen/x360"
            android:layout_height="@dimen/x50"
            android:layout_gravity="center|left"
            android:src="@mipmap/bg_right_title" />

        <TextView
            android:id="@+id/app_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x20"
            android:text="@string/app_title"
            android:textColor="@color/white"
            android:textSize="@dimen/x28"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_right"
            style="@style/Font10Style"
            android:layout_weight="1"
            android:gravity="right"
            android:text="2022年3月15日 星期二" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x320"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/x100">


        <LinearLayout
            android:id="@+id/ll_page_way"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <RelativeLayout
                android:id="@+id/ll_login_card_select"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/x20"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@mipmap/ic_login_card_select" />

                <TextView
                    style="@style/Font24Style"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/x210"
                    android:gravity="center"
                    android:text="刷卡登录" />


            </RelativeLayout>



            <RelativeLayout
                android:id="@+id/ll_login_psw_select"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/x20"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@mipmap/ic_login_psw_select" />

                <TextView
                    style="@style/Font24Style"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/x210"
                    android:gravity="center"
                    android:text="密码登录" />


            </RelativeLayout>



        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_page_card"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="match_parent">


            <FrameLayout
                android:id="@+id/cv_login_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x20"
                android:layout_weight="1">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/ic_card_login" />

                    <TextView
                        android:id="@+id/tv_getting"
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x210"
                        android:layout_marginBottom="@dimen/x10"
                        android:text="正在读取卡片信息登录..."
                        android:textColor="@color/color_font_blue" />

                    <EditText
                        android:layout_toRightOf="@id/tv_getting"
                        android:layout_alignBottom="@id/tv_getting"
                        android:textSize="@dimen/x15"
                        android:padding="@dimen/x5"
                        android:id="@+id/et_card_info"
                        android:text=""
                        android:focusable="true"
                        android:textColor="@android:color/transparent"
                        android:focusableInTouchMode="true"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>


                </RelativeLayout>

            </FrameLayout>


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/x20"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@mipmap/ic_login_card_select" />

                <TextView
                    style="@style/Font24Style"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/x210"
                    android:gravity="center"
                    android:text="刷卡登录" />


            </RelativeLayout>


        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_page_psw"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/x20"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@mipmap/ic_login_psw_select" />

                <TextView
                    style="@style/Font24Style"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/x210"
                    android:gravity="center"
                    android:text="密码登录" />


            </RelativeLayout>



            <FrameLayout
                android:id="@+id/cv_login_psw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x20"
                android:layout_weight="1.2"
                android:padding="@dimen/x10"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/x5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/bg_login_psw"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/x40"
                    android:paddingVertical="@dimen/x20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/x50"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/x40"
                            android:layout_height="@dimen/x40"
                            android:padding="@dimen/x10"
                            android:src="@mipmap/ic_user" />

<!--                        <EditText-->
<!--                            android:id="@+id/mUserName"-->
<!--                            style="@style/Font15Style"-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="match_parent"-->
<!--                            android:layout_marginLeft="@dimen/x10"-->
<!--                            android:background="@drawable/button_style_primary_line"-->
<!--                            android:hint="请输入帐号"-->
<!--                            android:inputType="text"-->
<!--                            android:text="gzcsqy01"-->
<!--                            android:textColorHint="@color/colorFontA"-->
<!--                            android:textSize="@dimen/x18" />-->


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/x5"
                            android:layout_marginLeft="@dimen/x10"
                            android:background="@mipmap/bg_edittext"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/mUserName"
                                android:imeOptions="actionNext"
                                android:hint="请输入帐号"
                                style="@style/EditTextStyle3"
                                android:textSize="@dimen/x15"
                                android:layout_gravity="center"
                                android:background="@null"
                                />

<!--                            android:text="gzcsqy01"-->

                        </LinearLayout>


                        <!--android:text="yibs-yw01"-->

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x15"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/x40"
                            android:layout_height="@dimen/x40"
                            android:padding="@dimen/x10"
                            android:src="@mipmap/ic_lock" />

<!--                        <EditText-->
<!--                            android:id="@+id/mPassWord"-->
<!--                            style="@style/Font15Style"-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="match_parent"-->
<!--                            android:layout_marginLeft="@dimen/x10"-->
<!--                            android:layout_weight="1"-->
<!--                            android:background="@drawable/button_style_primary_line"-->
<!--                            android:hint="请输入密码"-->
<!--                            android:inputType="textPassword"-->
<!--                            android:text="gdgf123zxc!@!"-->
<!--                            android:textColorHint="@color/colorFontA" />-->


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/x5"
                            android:layout_marginLeft="@dimen/x10"
                            android:background="@mipmap/bg_edittext"
                            android:gravity="left|center">

                            <EditText
                                android:hint="请输入密码"
                                android:id="@+id/mPassWord"
                                android:inputType="textPassword"
                                style="@style/EditTextStyle3"
                                android:layout_gravity="center"
                                android:textSize="@dimen/x15"
                                android:imeOptions="actionDone"
                                android:background="@null"
                                />

<!--                            android:text="gdgf123zxc!@!"-->

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/mIsShowPassWord"
                            android:layout_width="@dimen/x40"
                            android:layout_height="@dimen/x40"
                            android:padding="@dimen/x10"
                            android:src="@mipmap/ic_eye_close"
                            android:visibility="gone" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/x10"
                        android:layout_marginTop="@dimen/x15"
                        android:layout_marginBottom="@dimen/x10"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/mIsRemember"
                            android:layout_width="@dimen/x18"
                            android:layout_height="@dimen/x18"
                            android:layout_gravity="center"
                            android:background="@drawable/checkbox_style_0"
                            android:button="@null"
                            android:padding="@dimen/x5"
                            android:textColor="@color/colorFontA" />

                        <TextView
                            style="@style/Font15Style"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/x10"
                            android:text="记住密码" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:id="@+id/ll_server_info"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_weight="1"
                                android:gravity="right"
                                android:layout_gravity="center"
                                android:text="服务器配置"
                                android:autoLink="all"
                                android:layout_marginRight="@dimen/x5"
                                style="@style/Font12Style"/>

                            <ImageView
                                android:src="@mipmap/ic_menu_right"
                                android:layout_width="@dimen/x12"
                                android:layout_height="@dimen/x12"/>

                        </LinearLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/mLogin"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/x30"
                        android:layout_marginTop="@dimen/x20"
                        android:background="@drawable/button_style2"
                        android:text="登  录"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/x16" />


                </LinearLayout>

            </FrameLayout>



        </LinearLayout>



        <LinearLayout
            android:id="@+id/ll_page_net"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/x100"
            android:visibility="gone"
            android:layout_marginVertical="@dimen/x30"
            android:background="@mipmap/bg_login_psw"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/x40"
            android:paddingVertical="@dimen/x20">


            <RelativeLayout
                android:layout_width="@dimen/x80"
                android:layout_height="@dimen/x80">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/x5"
                    android:src="@mipmap/ic_network_check" />

                <ImageView
                    android:id="@+id/iv_net_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_network_check3" />


            </RelativeLayout>


            <com.grkj.ytjqy_pad.utils.view.BoldTextView
                android:id="@+id/tv_net_info"
                style="@style/Font12BlueStyle"
                android:layout_marginTop="@dimen/x20"
                android:text="网络/服务器检测"
                android:textSize="@dimen/x15" />


            <LinearLayout
                android:id="@+id/ll_net_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x10"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="invisible">

                <TextView
                    style="@style/Font12BlueStyle"
                    android:text="网络是否正常" />

                <ImageView
                    android:id="@+id/iv_net1"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:layout_marginLeft="@dimen/x10" />


                <TextView
                    android:id="@+id/tv_net1"
                    style="@style/Font12BlueStyle"
                    android:layout_marginHorizontal="@dimen/x5"
                    android:text=""
                    android:textColor="@color/color_yellow" />

                <TextView
                    style="@style/Font12BlueStyle"
                    android:layout_marginLeft="@dimen/x20"
                    android:text="服务器是否正常"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_net2"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:layout_marginLeft="@dimen/x10"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/tv_net2"
                    style="@style/Font12BlueStyle"
                    android:layout_marginHorizontal="@dimen/x5"
                    android:textColor="@color/color_yellow"
                    android:visibility="gone" />

            </LinearLayout>


            <Button
                android:id="@+id/btn_net"
                android:layout_width="@dimen/x100"
                android:layout_height="@dimen/x32"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/x20"
                android:background="@drawable/button_style1"
                android:text="开始检测"
                android:textColor="@android:color/white"
                android:textSize="@dimen/x13" />


        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/bg_logo_bottom">

        <!--            <ImageView-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_alignParentBottom="true"-->
        <!--                android:src="@mipmap/bg_logo_bottom" />-->


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_right_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_network_check2" />

            <TextView
                android:id="@+id/tv_right_bottom"
                style="@style/Font15Style"
                android:layout_marginTop="@dimen/x10"
                android:text="网络测试" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_left_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x30"
            android:layout_marginRight="@dimen/x10"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_left_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_exit_app" />

            <TextView
                android:id="@+id/tv_left_bottom"
                style="@style/Font15Style"
                android:layout_marginTop="@dimen/x10"
                android:text="退出应用" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                android:layout_marginBottom="@dimen/x3"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/x3"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

            <TextView
                android:id="@+id/tv_device"
                style="@style/Font10Style"
                android:layout_marginBottom="@dimen/x3"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前设备号:" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>
