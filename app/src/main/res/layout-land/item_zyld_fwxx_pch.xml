<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/x5"
    android:background="@mipmap/bg_edittext_disable"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/x10"
    android:paddingVertical="@dimen/x5">


    <TextView
        android:id="@+id/tv_item_zysl"
        style="@style/Font12Style"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:text="-" />

    <TextView
        android:id="@+id/tv_item_jssl"
        style="@style/Font12Style"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:text="-" />

    <TextView
        android:id="@+id/tv_item_jldw"
        style="@style/Font12Style"
        android:layout_width="0dp"
        android:layout_weight="0.8"
        android:gravity="center"
        android:maxLines="1"
        android:text="-" />

    <TextView
        android:id="@+id/tv_item_szsbm"
        style="@style/Font12Style"
        android:layout_width="0dp"
        android:layout_weight="2.2"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="-" />

    <TextView
        android:id="@+id/tv_item_ly"
        style="@style/Font12Style"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:text="-" />

    <LinearLayout
        android:id="@+id/ll_edit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/x15"
            android:layout_height="@dimen/x15"
            android:src="@mipmap/ic_about" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_delete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/x15"
            android:layout_height="@dimen/x15"
            android:src="@mipmap/ic_delete_colorful" />


    </LinearLayout>

</LinearLayout>
