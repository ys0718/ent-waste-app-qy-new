<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x50"
    android:background="@drawable/toolbar_bg"
    android:minHeight="@dimen/x60">

    <ImageView
        android:id="@+id/logo_iv"
        android:layout_width="wrap_content"
        android:layout_marginLeft="@dimen/x10"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:padding="@dimen/x10"
        android:src="@mipmap/ic_logo" />

    <TextView
        android:id="@+id/toolbar_title"
        style="@style/Size18TitleTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/logo_iv"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:text="@string/app_name"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="@dimen/x20"
        android:textStyle="bold" />

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/logout_ll"
        android:layout_alignParentRight="true"
        android:orientation="horizontal"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:gravity="center"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/user_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/x5"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x5"
            android:layout_marginRight="@dimen/x5"
            android:layout_toLeftOf="@+id/line2"
            android:text="欢迎您！张三"
            android:textColor="@color/white"
            android:textSize="@dimen/x18" />

        <View
            android:id="@+id/line2"
            android:layout_width="@dimen/x2"
            android:layout_height="@dimen/x18"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/x5"
            android:layout_toLeftOf="@+id/logout_tv"
            android:background="@color/line_color" />

        <TextView
            android:id="@+id/toolbar_right_menu"
            android:drawablePadding="@dimen/x10"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:padding="@dimen/x5"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x5"
            android:layout_marginRight="@dimen/x5"
            android:text="退出登录"
            android:layout_alignParentRight="true"
            android:drawableRight="@mipmap/ic_logout"
            android:textColor="@color/white"
            android:textSize="@dimen/x18" />

    </LinearLayout>


    <TextView
        android:id="@+id/back_iv"
        android:drawablePadding="@dimen/x10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/x5"
        android:gravity="center"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginRight="@dimen/x5"
        android:text="返回"
        android:layout_alignParentRight="true"
        android:drawableLeft="@mipmap/ic_back"
        android:textColor="@color/white"
        android:textSize="@dimen/x18" />

