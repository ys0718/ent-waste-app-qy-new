<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:gravity="top"
    android:padding="@dimen/x5"
    style="@style/FormLayoutStyle_C">

    <!--    <include layout="@layout/gr_view_item" />-->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/mLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@mipmap/bg_edittext"
            android:gravity="left|center">


            <AutoCompleteTextView
                android:id="@+id/repeateMode"
                style="@style/EditTextStyle3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:cacheColorHint="@color/white"
                android:completionThreshold="1"
                android:ems="10"
                android:gravity="center_vertical"
                android:textColor="@color/white">

            </AutoCompleteTextView>

            <ImageView
                android:id="@+id/iv_clear"
                android:layout_width="@dimen/x24"
                android:layout_height="@dimen/x24"
                android:padding="@dimen/x5"
                android:clickable="true"
                android:src="@mipmap/ic_clear"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_click"
                android:layout_width="@dimen/x12"
                android:layout_height="@dimen/x12"
                android:clickable="true"
                tools:ignore="NotSibling"
                android:visibility="gone"
                android:layout_marginHorizontal="@dimen/x10"
                android:src="@mipmap/ic_click_down" />


        </LinearLayout>


        <View
            android:id="@+id/tem_click_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@id/mLayout"
            android:layout_alignTop="@+id/mLayout"
            android:layout_alignRight="@id/repeateMode"
            android:layout_alignBottom="@+id/mLayout"
            tools:ignore="NotSibling" />

    </RelativeLayout>


</LinearLayout>





