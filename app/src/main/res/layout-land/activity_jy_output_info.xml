                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_cancel_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="删除" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_check"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginRight="@dimen/x20"
                android:background="@drawable/button_style2"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_hand_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="校准" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_handle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x28"
                    android:layout_marginRight="@dimen/x20"
                    android:background="@drawable/button_style1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_handle"
                        style="@style/BtnFontStyle"
                        android:layout_marginLeft="@dimen/x5"
                        android:padding="0dp"
                        android:text="校准" />

                    <ImageView
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:src="@mipmap/ic_menu_right" />


                </LinearLayout>

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>
