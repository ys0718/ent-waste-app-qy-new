<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_login"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar_new" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/x20">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="关于" />


            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginLeft="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>



        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/x80">

                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/bg_login_psw"
                    android:gravity="center|left"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/x10"
                    android:paddingHorizontal="@dimen/x20">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/x10"
                            android:orientation="horizontal">


                            <TextView
                                style="@style/Font12BlueStyle"
                                android:text="当前版本号：" />


                            <TextView
                                android:id="@+id/tv_item1"
                                style="@style/Font12Style"
                                android:text="V1.0.1" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/x10"
                            android:orientation="horizontal">


                            <TextView
                                style="@style/Font12BlueStyle"
                                android:text="设备号：" />


                            <TextView
                                android:id="@+id/tv_item2"
                                style="@style/Font12Style"
                                android:text="-" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/x10"
                            android:orientation="horizontal">


                            <TextView
                                style="@style/Font12BlueStyle"
                                android:text="技术支持：" />


                            <TextView
                                android:id="@+id/tv_item3"
                                style="@style/Font12Style"
                                android:text="@string/str_support2" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/x10"
                            android:orientation="horizontal">


                            <TextView
                                style="@style/Font12BlueStyle"
                                android:text="联系人：" />


                            <TextView
                                android:id="@+id/tv_item4"
                                style="@style/Font12Style"
                                android:text="@string/str_about_contact" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/x10"
                            android:orientation="horizontal">


                            <TextView
                                style="@style/Font12BlueStyle"
                                android:text="联系电话：" />


                            <TextView
                                android:id="@+id/tv_item5"
                                style="@style/Font12Style"
                                android:text="@string/str_about_phone" />

                        </LinearLayout>



                </LinearLayout>


                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />


            </LinearLayout>


        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:background="@mipmap/bg_logo_bottom">


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_right_bottom1"
                style="@style/Font10Style"
                android:text="当前第一页" />


            <TextView
                android:id="@+id/tv_right_bottom2"
                style="@style/Font10Style"
                android:text="共5页，共30条" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_left_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x30"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.grkj.ytjqy_pad.utils.view.BoldTextView
                android:id="@+id/tv_left_bottom"
                style="@style/Font24Style"
                android:text="2.999" />


            <TextView
                style="@style/Font10Style"
                android:text="合计产生(吨)" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x30"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_back"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style1"
                android:layout_marginRight="@dimen/x20"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_back_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="返回" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_check_version"
                android:layout_width="wrap_content"
                android:layout_marginLeft="@dimen/x20"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style3"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_check_version" />

                <TextView
                    style="@style/Font10Style"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="检查更新" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>