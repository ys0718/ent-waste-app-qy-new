<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:padding="@dimen/x10"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/layoutFileSelectList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/x10"
        android:orientation="vertical"
        android:showDividers="middle|end">

        <TextView
            android:id="@+id/curPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x5"
            android:paddingLeft="@dimen/x10"
            android:textSize="@dimen/x15" />

        <LinearLayout
            android:id="@+id/layoutFileListHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x10"
            android:showDividers="beginning|middle|end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutReturnRoot"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x40"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_return_root"
                    android:layout_width="@dimen/x30"
                    android:layout_height="@dimen/x30"
                    android:background="@mipmap/ic_return">

                </ImageView>

                <TextView
                    android:id="@+id/tv_return_root"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/x10"
                    android:text="返回根目录"
                    android:textSize="@dimen/x15">

                </TextView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutReturnPre"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x40"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_return_pre"
                    android:layout_width="@dimen/x30"
                    android:layout_height="@dimen/x30"
                    android:background="@mipmap/ic_return_root">

                </ImageView>

                <TextView
                    android:id="@+id/tv_return_pre"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/x10"
                    android:text="返回上一层"
                    android:textSize="@dimen/x15">

                </TextView>

            </LinearLayout>

        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </LinearLayout>

</LinearLayout>