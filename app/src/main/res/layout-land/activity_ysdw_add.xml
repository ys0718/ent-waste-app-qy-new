<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_login"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar_new" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x20"
            android:gravity="center"
            android:paddingHorizontal="@dimen/x20">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="添加运输单位信息" />


            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginLeft="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>


        </LinearLayout>


        <com.grkj.ytjqy_pad.utils.view.MyScrollView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/x10">


                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout
                        style="@style/FormLayoutStyle_C"
                        android:gravity="left"
                        android:orientation="vertical">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_ysdw_item1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@mipmap/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item_ysdwmc"
                                    style="@style/EditTextStyle3"
                                    android:enabled="false"
                                    android:hint="@string/str_ysdw_hint1" />


                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/ll_query"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/x40"
                                android:visibility="gone"
                                android:layout_marginLeft="@dimen/x10"
                                android:background="@drawable/button_orange2"
                                android:gravity="center">

                                <ImageView
                                    style="@style/BtnImgStyle"
                                    android:layout_marginRight="0dp"
                                    android:src="@mipmap/ic_search" />

                                <TextView
                                    style="@style/BtnFontStyle"
                                    android:text="查询" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- 名称校验提示 -->
                        <TextView
                            android:id="@+id/tv_ysdwmc_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/x10"
                            android:text="ysdwmc is required"
                            android:textColor="#e51e5f"
                            android:textSize="@dimen/x12"
                            android:visibility="gone" />

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_ysdw_item2" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_yslx"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:layout_gravity="center"
                                android:background="@null"
                                android:focusableInTouchMode="false"
                                android:hint="@string/str_ysdw_hint2" />

                            <ImageView
                                android:layout_width="@dimen/x12"
                                android:layout_height="@dimen/x12"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginHorizontal="@dimen/x10"
                                android:clickable="false"
                                android:src="@mipmap/ic_click_down" />

                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_ysdw_item3" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysfs"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:layout_gravity="center"
                                android:background="@null"
                                android:focusableInTouchMode="false"
                                android:hint="@string/str_ysdw_hint3" />

                            <ImageView
                                android:layout_width="@dimen/x12"
                                android:layout_height="@dimen/x12"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginHorizontal="@dimen/x10"
                                android:clickable="false"
                                android:src="@mipmap/ic_click_down" />

                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_ysdw_item4" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysqyid"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:layout_gravity="center"
                                android:enabled="false"
                                android:background="@null" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_zyld_item15" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysdwlxr"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:layout_gravity="center"
                                android:enabled="false"
                                android:background="@null" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_zyld_item16" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysdwlxrsj"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:enabled="false"
                                android:layout_gravity="center"
                                android:background="@null" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_zyld_item17" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysdwxkzh"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:enabled="false"
                                android:layout_gravity="center"
                                android:background="@null" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_zyld_item18" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysdwxydm"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:enabled="false"
                                android:layout_gravity="center"
                                android:background="@null" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_zyld_item19" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@mipmap/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item_ysdwdz"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:layout_gravity="center"
                                android:enabled="false"
                                android:background="@null" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </com.grkj.ytjqy_pad.utils.view.MyScrollView>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/x60"
            android:background="@mipmap/bg_logo_bottom">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_back"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x28"
                    android:layout_marginRight="@dimen/x20"
                    android:background="@drawable/button_style1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:src="@mipmap/ic_back_white" />

                    <TextView
                        style="@style/BtnFontStyle"
                        android:layout_marginLeft="@dimen/x5"
                        android:padding="0dp"
                        android:text="返回" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/ll_save"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x28"
                    android:layout_marginRight="@dimen/x20"
                    android:background="@drawable/button_style2"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:src="@mipmap/ic_save_white" />

                    <TextView
                        style="@style/BtnFontStyle"
                        android:layout_marginLeft="@dimen/x5"
                        android:padding="0dp"
                        android:text="保存" />

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:focusable="true"
                android:gravity="center|bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_company"
                    style="@style/Font10Style"
                    android:text="@string/str_support" />

                <TextView
                    android:id="@+id/mVersion"
                    style="@style/Font10Style"
                    android:layout_marginLeft="@dimen/x10"
                    android:text="当前版本:V1.0.0" />

            </LinearLayout>


        </RelativeLayout>


    </LinearLayout>

</LinearLayout>
