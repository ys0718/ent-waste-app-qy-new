<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_login"
    android:gravity="center_horizontal"
    android:id="@+id/mLayout"
    android:orientation="vertical">


    <include layout="@layout/view_toolbar_new" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/x20">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_marginRight="@dimen/x30"
                android:text="补打标签" />

            <!--            <LinearLayout-->
            <!--                android:layout_width="@dimen/x150"-->
            <!--                android:layout_height="match_parent"-->
            <!--                android:background="@mipmap/bg_edittext"-->
            <!--                android:clickable="true"-->
            <!--                android:descendantFocusability="blocksDescendants"-->
            <!--                android:visibility="gone"-->
            <!--                android:focusable="true"-->
            <!--                android:focusableInTouchMode="true"-->
            <!--                android:gravity="left|center">-->

            <!--                <com.grkj.ytjqy_pad.utils.popwindow.spinner.SearchSpinner-->
            <!--                    android:id="@+id/editSpinner_22"-->
            <!--                    android:layout_width="@dimen/x150"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:layout_margin="10dp"-->
            <!--                    app:hint="@string/str_loading" />-->


            <!--            </LinearLayout>-->


            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:id="@id/ll_search"
                android:gravity="center"
                android:layout_height="wrap_content">


                <com.grkj.ytjqy_pad.utils.view.InputSelectView
                    android:id="@+id/isv_fwxxmc"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    app:hint="废物详细名称"
                    android:layout_height="wrap_content"/>

                <com.grkj.ytjqy_pad.utils.view.SelectTimeView
                    android:id="@+id/v_select_time"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_marginHorizontal="@dimen/x15"
                    android:layout_height="wrap_content"/>


                <com.grkj.ytjqy_pad.utils.view.InputSelectView
                    android:id="@+id/isv_djlx"
                    android:layout_width="0dp"
                    app:enabled="false"
                    android:layout_weight="0.8"
                    android:layout_height="wrap_content"/>


                <LinearLayout
                    android:id="@+id/ll_search_click"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x28"
                    android:layout_marginLeft="@dimen/x15"
                    android:background="@drawable/button_style2"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/x12"
                        android:layout_height="@dimen/x12"
                        android:src="@mipmap/ic_search" />

                    <TextView
                        style="@style/BtnFontStyle"
                        android:layout_marginLeft="@dimen/x5"
                        android:padding="0dp"
                        android:text="搜索" />


                </LinearLayout>


            </LinearLayout>



            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginLeft="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>



        </LinearLayout>


        <LinearLayout style="@style/FormLayoutStyle_P">


            <LinearLayout
                android:paddingHorizontal="@dimen/x10"
                android:id="@+id/ll_select_all"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_select_all"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/x10"
                    android:src="@mipmap/ic_unselected" />

                <TextView
                    android:layout_width="wrap_content"
                    style="@style/FormTitleStyle"
                    android:text="全选" />

            </LinearLayout>


            <TextView
                android:id="@+id/tv_num"
                style="@style/FormTitleStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginRight="@dimen/x30"
                android:layout_gravity="right"
                android:gravity="right"
                android:text="已选中0条" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/x10">

            <com.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/x10">


                <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
                    android:id="@+id/mRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/x10" />

            </com.scwang.smartrefresh.layout.SmartRefreshLayout>


        </LinearLayout>


    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:background="@mipmap/bg_logo_bottom">


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x60"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_right_bottom1"
                style="@style/Font12Style"
                android:text="当前第一页"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tv_right_bottom2"
                style="@style/Font12Style"
                android:layout_gravity="center"
                android:text="共1页，共0条" />

        </LinearLayout>


        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="@dimen/x150"
            android:layout_height="wrap_content">


            <LinearLayout
                android:id="@+id/ll_left_bottom"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x10"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

                <com.grkj.ytjqy_pad.utils.view.BoldTextView
                    android:id="@+id/tv_left_bottom"
                    style="@style/Font24Style"
                    android:text="0.000"
                    android:maxLines="1"
                    android:textSize="@dimen/x18"
                    android:textColor="@color/colorFontOrange" />


                <TextView
                    android:id="@+id/tv_left_bottom2"
                    style="@style/Font10Style"
                    android:text="入库(吨)" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_left_bottom2"
                android:layout_weight="1"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_toRightOf="@+id/ll_left_bottom"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:gravity="center"
                android:orientation="vertical">

                <com.grkj.ytjqy_pad.utils.view.BoldTextView
                    android:id="@+id/tv_left_bottom3"
                    style="@style/Font24Style"
                    android:textSize="@dimen/x18"
                    android:maxLines="1"
                    android:text="0.000"
                    android:textColor="@color/colorFontOrange" />


                <TextView
                    android:id="@+id/tv_left_bottom4"
                    style="@style/Font10Style"
                    android:text="出库(吨)" />

            </LinearLayout>


        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x30"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_back"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style1"
                android:layout_marginRight="@dimen/x10"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_back_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="返回" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_print"
                android:layout_width="wrap_content"
                android:layout_marginLeft="@dimen/x10"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style2"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_hand_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="去打印" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>
