<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_margin="@dimen/x30"
app:cardCornerRadius="@dimen/x10">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/x20">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/x10"
        android:text="温馨提示"
        android:textColor="@color/colorFontA"
        android:textSize="@dimen/x18" />


    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/x100"
        android:visibility="gone"
        android:layout_height="@dimen/x100"
        android:layout_gravity="center"
        android:src="@mipmap/ic_save_tips" />


    <TextView
        android:id="@+id/tv_des"
        style="@style/Font15Style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone"
        android:padding="@dimen/x20"
        android:text="是否确认保存？"
        android:textColor="@color/colorFontA" />


    <com.grkj.ytjqy_pad.utils.view.SelectTimeView
        android:id="@+id/v_select_time"
        android:layout_width="match_parent"
        android:layout_marginVertical="@dimen/x10"
        android:layout_marginHorizontal="@dimen/x15"
        android:layout_height="wrap_content"/>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x48"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_cancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x40"
            android:background="@drawable/button_cancel"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cancel"
                style="@style/BtnFontStyle"
                android:layout_marginLeft="@dimen/x5"
                android:padding="0dp"
                android:text="取消"
                android:textColor="@color/colorFontA" />


        </LinearLayout>

        <View
            android:id="@+id/view_margin"
            android:layout_width="@dimen/x20"
            android:layout_height="0dp" />


        <LinearLayout
            android:id="@+id/ll_confirm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x40"
            android:background="@drawable/button_style2"
            android:gravity="center">


            <TextView
                android:id="@+id/tv_confirm"
                style="@style/BtnFontStyle"
                android:layout_marginLeft="@dimen/x5"
                android:padding="0dp"
                android:text="确定" />


        </LinearLayout>

    </LinearLayout>
</LinearLayout>

</android.support.v7.widget.CardView>
