<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">


    <!--    <RelativeLayout-->
    <!--        android:layout_weight="1"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="@dimen/x60"-->
    <!--        android:background="@mipmap/ic_login_top">-->

    <!--        <TextView-->
    <!--            style="@style/Font24Style"-->
    <!--            android:layout_centerInParent="true"-->
    <!--            android:text="合计产生(吨)" />-->


    <!--    </RelativeLayout>-->


    <include
        layout="@layout/view_toolbar_new"
        android:layout_width="wrap_content"
        android:visibility="gone"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/view_toolbar_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:paddingHorizontal="@dimen/x20">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_height="match_parent"
                android:padding="0dp"
                android:text="转移联单" />

            <TextView
                android:id="@+id/tv_title2"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:visibility="invisible"
                android:layout_weight="1"
                android:text="（只展示当天数据）" />



            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>


        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/x20"
            android:paddingHorizontal="@dimen/x20">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/x5"
                android:background="@drawable/bg_edittext"
                android:layout_gravity="start"
                android:gravity="left|center">

            <EditText
                android:id="@+id/et_item_jsdwmc"
                style="@style/EditTextStyle3"
                android:gravity="start"
                android:layout_marginHorizontal="0dp"
                android:layout_width="match_parent"
                android:padding="@dimen/x5"
                android:layout_gravity="center"
                android:hint="输入接收单位名称"
                android:background="@null" />


        </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/x5"
                android:background="@drawable/bg_edittext"
                android:gravity="left|center">


                <EditText
                    android:id="@+id/et_item_ycdwmc"
                    style="@style/EditTextStyle3"
                    android:layout_width="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="0dp"
                    android:padding="@dimen/x5"
                    android:gravity="start"
                    android:hint="输入移出单位名称"
                    android:background="@null" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center|start"
            android:layout_marginTop="@dimen/x10"
            android:paddingHorizontal="@dimen/x20">


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:id="@+id/ll_actid"
                android:layout_marginHorizontal="@dimen/x5"
                android:layout_gravity="center"
                android:background="@drawable/bg_edittext"
                android:visibility="gone"
                android:gravity="left|center">

                <EditText
                    android:id="@+id/et_item_actid"
                    style="@style/EditTextStyle3"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="0dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:focusableInTouchMode="false"
                    android:hint="请选择联单节点状态" />

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="@dimen/x10"
                    android:clickable="false"
                    android:src="@mipmap/ic_click_down" />

            </RelativeLayout>


            <LinearLayout
                android:id="@+id/ll_clear_click"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/x40"
                android:layout_marginLeft="@dimen/x5"
                android:background="@drawable/button_style_gray"
                android:gravity="center">

                <ImageView
                    style="@style/BtnImgStyle"
                    android:layout_margin="@dimen/x10"
                    android:src="@mipmap/ic_delete_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:textSize="@dimen/x15"
                    android:layout_marginRight="@dimen/x10"
                    android:text="清空" />



            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_search_click"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/x40"
                android:layout_marginLeft="@dimen/x10"
                android:background="@drawable/button_style_primary"
                android:gravity="center">

                <ImageView
                    style="@style/BtnImgStyle"
                    android:layout_margin="@dimen/x10"
                    android:src="@mipmap/ic_search" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:textSize="@dimen/x15"
                    android:layout_marginRight="@dimen/x10"
                    android:text="搜索" />



            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_add"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/x40"
                android:layout_marginLeft="@dimen/x10"
                android:background="@drawable/button_green2"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_right1"
                    style="@style/BtnImgStyle"
                    android:src="@mipmap/ic_add" />

                <TextView
                    android:id="@+id/tv_right1"
                    style="@style/BtnFontStyle"
                    android:textSize="@dimen/x15"
                    android:layout_marginRight="@dimen/x5"
                    android:text="新增" />


            </LinearLayout>




        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/x10">

            <com.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/x10">


                <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
                    android:id="@+id/mRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/x10" />

            </com.scwang.smartrefresh.layout.SmartRefreshLayout>


        </LinearLayout>


    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:visibility="gone"
        android:background="@mipmap/bg_logo_bottom">


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x60"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_right_bottom1"
                style="@style/Font12Style"
                android:text="当前第一页"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tv_right_bottom2"
                style="@style/Font12Style"
                android:layout_gravity="center"
                android:text="共1页，共0条" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x30"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_back"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_back_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="返回" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>
