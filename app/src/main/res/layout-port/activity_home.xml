<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/x10"
            android:gravity="left|center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/x20"
            android:paddingVertical="@dimen/x10">

            <ImageView
                android:id="@+id/login_logo_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/x10"
                android:src="@mipmap/ic_login_top_logo" />

            <TextView
                android:id="@+id/app_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x20"
                android:text="@string/app_title"
                android:textColor="@color/white"
                android:textSize="@dimen/x28"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_right"
                style="@style/Font15Style"
                android:layout_weight="1"
                android:gravity="right"
                android:text="2022年3月15日 星期二"
                android:visibility="gone" />


        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/x250"
            android:background="@mipmap/bg_top" />


        <!--        <View-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="@dimen/x300"-->
        <!--            android:background="@drawable/button_style1" />-->


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/x30"
            android:orientation="vertical">


            <TextView
                style="@style/Size18TitleTextStyle"
                android:layout_height="@dimen/x60"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_top2"
                style="@style/Font24Style"
                android:layout_gravity="left"
                android:layout_marginHorizontal="@dimen/x10"
                android:layout_marginTop="@dimen/x20"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="admin,欢迎您"
                android:textSize="@dimen/x20"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x10"
                android:layout_marginTop="@dimen/x10"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x18"
                    android:layout_height="@dimen/x18"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_time_white" />

                <TextView
                    android:id="@+id/tv_tips"
                    style="@style/Font15Style"
                    android:layout_gravity="left"
                    android:gravity="center"
                    android:text="截至时间：2022-06-30  数据已更新"
                    android:textColor="#D9E5FE" />


            </LinearLayout>


            <TextView
                style="@style/Font16Style"
                android:layout_marginLeft="@dimen/x20"
                android:layout_marginTop="@dimen/x20"
                android:text="截至时间：2022-11-11 数据已更新"
                android:visibility="gone" />


            <!--            <com.tamsiree.rxui.view.RxTitle-->
            <!--               app:title="aaaaaaaaaasdasdas"-->
            <!--                app:titleColor="@color/white"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"/>-->


            <android.support.v7.widget.CardView
                android:id="@+id/mMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/x5"
                android:layout_marginTop="@dimen/x20"
                app:cardCornerRadius="@dimen/x10"
                app:cardElevation="@dimen/x1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/ll_cflj"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/x10">


                        <TextView
                            style="@style/Font16Style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/button_orange"
                            android:lines="1"
                            android:padding="@dimen/x10"
                            android:text="产废累计"
                            android:textColor="@color/colorFontOrange"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_cflj"
                                style="@style/Font24Style"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:padding="0dp"
                                android:paddingVertical="@dimen/x5"
                                android:text="0.000"
                                android:textColor="@color/colorFontOrange"
                                android:textSize="@dimen/x28" />

                            <TextView
                                style="@style/Font16Style"
                                android:padding="0dp"
                                android:text="吨"
                                android:textColor="@color/colorFontB" />

                        </LinearLayout>


                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/x1"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/x20"
                        android:background="@color/line_color" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/x10">


                        <TextView
                            style="@style/Font16Style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/button_green"
                            android:lines="1"
                            android:padding="@dimen/x10"
                            android:text="入库累计"
                            android:textColor="@color/colorFontGreen"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_rklj"
                                style="@style/Font24Style"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:padding="0dp"
                                android:paddingVertical="@dimen/x5"
                                android:text="0.000"
                                android:textColor="@color/colorFontGreen"
                                android:textSize="@dimen/x28" />

                            <TextView
                                style="@style/Font16Style"
                                android:padding="0dp"
                                android:text="吨"
                                android:textColor="@color/colorFontB" />

                        </LinearLayout>


                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/x1"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/x20"
                        android:background="@color/line_color" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/x10">


                        <TextView
                            style="@style/Font16Style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/button_blue"
                            android:lines="1"
                            android:padding="@dimen/x10"
                            android:text="出库累计"
                            android:textColor="@color/colorFontBlue" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_cklj"
                                style="@style/Font24Style"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:padding="0dp"
                                android:paddingVertical="@dimen/x5"
                                android:text="0.000"
                                android:textColor="@color/colorFontBlue"
                                android:textSize="@dimen/x28" />

                            <TextView
                                style="@style/Font16Style"
                                android:padding="0dp"
                                android:text="吨"
                                android:textColor="@color/colorFontB" />

                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>


            </android.support.v7.widget.CardView>


            <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
                android:id="@+id/btnRv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x60"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/x10"
                android:layout_marginBottom="@dimen/x10"
                android:foregroundGravity="center"
                android:overScrollMode="never"
                android:scrollbars="none" />


            <LinearLayout
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content">

                <com.grkj.ytjqy_pad.utils.view.MarqueeView
                    android:id="@+id/marqueeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="心中有阳光，脚底有力量！心中有阳光，脚底有力量！心中有阳光，脚底有力量！心中有阳光，脚底有力量！心中有阳光，脚底有力量！心中有阳光，脚底有力量！"
                    android:textColor="@color/color_font_red"
                    android:textSize="@dimen/x20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />


            </LinearLayout>


            <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
                android:id="@+id/mRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/x16"
                android:layout_marginBottom="@dimen/x90"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none" />


            <ImageView
                android:id="@+id/iv_left"
                android:layout_width="@dimen/x40"
                android:layout_height="@dimen/x40"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/x10"
                android:padding="@dimen/x5"
                android:src="@mipmap/ic_menu_left"
                android:visibility="gone" />


        </LinearLayout>


        <ImageView
            android:id="@+id/iv_right"
            android:layout_width="@dimen/x40"
            android:layout_height="@dimen/x40"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/x10"
            android:padding="@dimen/x5"
            android:src="@mipmap/ic_menu_right"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x10"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


    </com.scwang.smartrefresh.layout.SmartRefreshLayout>

</LinearLayout>
