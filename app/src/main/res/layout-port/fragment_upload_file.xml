<?xml version="1.0" encoding="utf-8"?>
<com.grkj.ytjqy_pad.utils.view.GrScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/mLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/x100"
        android:paddingRight="@dimen/x100">

        <TextView
            android:id="@+id/item1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x40"
            android:layout_marginBottom="@dimen/x20"
            android:layout_marginLeft="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginTop="@dimen/x30"
            android:background="@drawable/button_style_form"
            android:drawableRight="@mipmap/ic_list_click"
            android:gravity="left|center"
            android:hint="请选择"
            android:padding="@dimen/x10"
            android:textSize="@dimen/x15" />

        <TextView
            android:id="@+id/select_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/x10"
            android:layout_toLeftOf="@+id/line2"
            android:padding="@dimen/x5"
            android:textColor="@color/colorFontA"
            android:textSize="@dimen/x18"
            android:visibility="gone" />

        <LinearLayout
            android:layout_marginBottom="@dimen/x20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/select_file_ll"
                android:layout_width="0dp"
                android:layout_height="@dimen/x40"
                android:layout_marginLeft="@dimen/x10"
                android:layout_weight="1"
                android:background="@drawable/button_style2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/x5">

                <ImageView
                    android:layout_width="@dimen/x30"
                    android:layout_height="@dimen/x30"
                    android:padding="@dimen/x5"
                    android:src="@mipmap/ic_add" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="选择文件..."
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x15" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/upload_ll"
                android:layout_width="0dp"
                android:layout_height="@dimen/x40"
                android:layout_marginLeft="@dimen/x10"
                android:layout_weight="1"
                android:background="@drawable/button_style1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/x5">

                <ImageView
                    android:layout_width="@dimen/x30"
                    android:layout_height="@dimen/x30"
                    android:padding="@dimen/x5"
                    android:src="@mipmap/ic_upload" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="开始上传"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x15" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cancel_ll"
                android:layout_width="0dp"
                android:layout_height="@dimen/x40"
                android:layout_marginLeft="@dimen/x10"
                android:layout_weight="1"
                android:background="@drawable/button_style3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/x5">

                <ImageView
                    android:layout_width="@dimen/x30"
                    android:layout_height="@dimen/x30"
                    android:padding="@dimen/x5"
                    android:src="@mipmap/ic_cancel" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="全部取消"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/x15" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2" />


        </LinearLayout>

    </LinearLayout>

</com.grkj.ytjqy_pad.utils.view.GrScrollView>