<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar_new"
        android:visibility="gone"/>

    <include layout="@layout/view_toolbar" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x20"
            android:gravity="center"
            android:visibility="gone"
            android:paddingHorizontal="@dimen/x20">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="正在扫码" />


            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginLeft="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/x10">

            <LinearLayout style="@style/FormLayoutStyle_P">

                <LinearLayout style="@style/FormLayoutStyle_C">

                    <TextView
                        style="@style/FormTitleStyleLong"
                        android:text="@string/str_wwly_item18" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext"
                        android:gravity="left|center">

                        <EditText
                            android:id="@+id/et_item19"
                            style="@style/EditTextStyle3"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:focusableInTouchMode="false"
                            android:hint="@string/common_select_tips"
                            android:textSize="@dimen/x12" />

                        <ImageView
                            android:clickable="false"
                            android:layout_width="@dimen/x18"
                            android:layout_height="@dimen/x18"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="@dimen/x10"
                            android:src="@mipmap/ic_click_down" />

                    </RelativeLayout>


                </LinearLayout>

                <LinearLayout style="@style/FormLayoutStyle_C">

                    <TextView
                        style="@style/FormTitleStyle"
                        android:text="@string/str_wwly_item27" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext"
                        android:gravity="left|center">

                        <EditText
                            android:id="@+id/et_item27"
                            style="@style/EditTextStyle3"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:focusableInTouchMode="false"
                            android:hint="@string/common_select_tips"
                            android:paddingRight="@dimen/x30"
                            android:textSize="@dimen/x12" />

                        <ImageView
                            android:clickable="false"
                            android:layout_width="@dimen/x18"
                            android:layout_height="@dimen/x18"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="@dimen/x10"
                            android:src="@mipmap/ic_click_down" />

                    </RelativeLayout>


                </LinearLayout>

            </LinearLayout>

            <LinearLayout style="@style/FormLayoutStyle_P">

                <LinearLayout style="@style/FormLayoutStyle_C">

                    <TextView
                        style="@style/FormTitleStyle"
                        android:text="@string/str_wwly_item20" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext"
                        android:gravity="left|center">

                        <EditText
                            android:id="@+id/et_item21"
                            style="@style/EditTextStyle3"
                            android:hint="@string/common_input_tips"
                            android:layout_gravity="center"
                            android:background="@null" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout style="@style/FormLayoutStyle_C">

                    <TextView
                        style="@style/FormTitleStyle"
                        android:text="@string/str_wwly_item26" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext"
                        android:gravity="left|center">

                        <EditText
                            android:id="@+id/et_item26"
                            style="@style/EditTextStyle3"
                            android:hint="@string/common_input_tips"
                            android:layout_gravity="center"
                            android:background="@null" />

                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>


            <LinearLayout style="@style/FormLayoutStyle_P">

                <LinearLayout style="@style/FormLayoutStyle_C">

                    <TextView
                        style="@style/FormTitleStyle"
                        android:text="总重量：" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext_disable"
                        android:gravity="left|center">

                        <TextView
                            android:id="@+id/et_item8"
                            style="@style/EditTextStyle3"
                            android:layout_gravity="center"
                            android:layout_weight="1.5"
                            android:background="@null"
                            android:gravity="center"
                            android:hint="扫码后自动统计"
                            android:inputType="numberDecimal" />

                        <View
                            android:layout_width="@dimen/x1"
                            android:layout_height="match_parent"
                            android:background="@color/colorFontB" />


                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item17"
                                style="@style/EditTextStyle3"
                                android:layout_width="match_parent"
                                android:layout_gravity="center"
                                android:background="@null"
                                android:focusableInTouchMode="false"
                                android:gravity="center"
                                android:text="吨" />

                        </RelativeLayout>


                    </LinearLayout>


                </LinearLayout>


<!--                <LinearLayout-->
<!--                    android:id="@+id/ll_htbh"-->
<!--                    style="@style/FormLayoutStyle_C"-->
<!--                    android:visibility="gone">-->

<!--                    <TextView-->
<!--                        style="@style/FormTitleStyle"-->
<!--                        android:text="@string/str_input_item20"-->
<!--                        android:textSize="@dimen/x13" />-->

<!--                    <LinearLayout-->
<!--                        android:id="@+id/ll_item20"-->
<!--                        style="@style/SearchSpinnerLayoutStyle">-->

<!--                        <com.grkj.ytjqy_pad.utils.popwindow.spinner.SearchSpinner-->
<!--                            android:id="@+id/editSpinner_20"-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_margin="10dp"-->
<!--                            app:hint="@string/str_loading" />-->


<!--                    </LinearLayout>-->

<!--                </LinearLayout>-->

            </LinearLayout>


            <LinearLayout style="@style/FormLayoutStyle_P">

                <LinearLayout style="@style/FormLayoutStyle_C">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext_disable"
                        android:gravity="left|center">

                        <EditText
                            android:id="@+id/et_scan"
                            style="@style/EditTextStyle3"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:enabled="false"
                            android:focusableInTouchMode="false"
                            android:gravity="center"
                            android:hint="请点击开始扫码" />


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/ll_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/x20"
                        android:background="@drawable/button_style2"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/x18"
                            android:layout_height="@dimen/x18"
                            android:src="@mipmap/ic_scan" />

                        <TextView
                            style="@style/BtnFontStyle"
                            android:layout_marginLeft="@dimen/x5"
                            android:padding="0dp"
                            android:text="开始扫描" />

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/x10">

                    <ImageView
                        android:id="@+id/iv_select_all"
                        android:layout_width="@dimen/x20"
                        android:layout_height="@dimen/x20"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/x10"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:src="@mipmap/ic_unselected" />

                    <TextView
                        style="@style/FormTitleStyle"
                        android:layout_width="wrap_content"
                        android:text="全选" />

                </LinearLayout>


                <TextView
                    android:id="@+id/tv_num"
                    style="@style/FormTitleStyle"
                    android:layout_width="0dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="待入库列表(0条)" />

                <LinearLayout
                    android:id="@+id/ll_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/x10">

                    <TextView
                        style="@style/FormTitleStyle"
                        android:layout_width="wrap_content"
                        android:text="清空" />

                    <ImageView
                        android:id="@+id/iv_clear_all"
                        android:layout_width="@dimen/x20"
                        android:layout_height="@dimen/x20"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/x10"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:src="@mipmap/ic_delete_colorful" />


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


    <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
        android:id="@+id/mRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/x10" />


    <!--    <LinearLayout-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_alignParentBottom="true"-->
    <!--        android:layout_marginVertical="@dimen/x10"-->
    <!--        android:focusable="true"-->
    <!--        android:gravity="center|bottom"-->
    <!--        android:orientation="horizontal">-->

    <!--        <LinearLayout-->
    <!--            android:id="@+id/ll_save"-->
    <!--            style="@style/BottomBtnStyle"-->
    <!--            android:layout_marginHorizontal="@dimen/x20"-->
    <!--            android:background="@drawable/button_style2">-->

    <!--            <ImageView-->
    <!--                style="@style/BtnImgStyle"-->
    <!--                android:src="@mipmap/ic_save_white" />-->

    <!--            <TextView-->
    <!--                style="@style/BtnFontStyle"-->
    <!--                android:text="保存" />-->

    <!--        </LinearLayout>-->


    <!--    </LinearLayout>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="@dimen/x10"
        android:focusable="true"
        android:gravity="center|bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_save"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:background="@drawable/button_style2">

            <ImageView
                style="@style/BtnImgStyle"
                android:src="@mipmap/ic_save_white" />

            <TextView
                style="@style/BtnFontStyle"
                android:text="保存" />

        </LinearLayout>


    </LinearLayout>


    <RelativeLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:background="@mipmap/bg_logo_bottom">


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_right_bottom1"
                style="@style/Font10Style"
                android:text="当前第一页" />


            <TextView
                android:id="@+id/tv_right_bottom2"
                style="@style/Font10Style"
                android:text="共5页，共30条" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_left_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x30"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.grkj.ytjqy_pad.utils.view.BoldTextView
                android:id="@+id/tv_left_bottom"
                style="@style/Font24Style"
                android:text="2.999" />


            <TextView
                style="@style/Font10Style"
                android:text="合计产生(吨)" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>

