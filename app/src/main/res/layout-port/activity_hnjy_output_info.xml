<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.grkj.ytjqy_pad.utils.view.GrScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/x10">

                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout style="@style/FormLayoutStyle_C">

                        <TextView
                            style="@style/FormTitleStyle"
                            android:text="@string/str_output_item1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_edittext_disable"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item1"
                                style="@style/EditTextStyle3"
                                android:layout_gravity="center"
                                android:background="@null"
                                android:ellipsize="end"
                                android:enabled="false"
                                android:hint="@string/str_auto_get"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColorHint="@color/color_font_red" />

                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>


                <com.grkj.ytjqy_pad.utils.view.MyLinearLayout
                    android:id="@+id/ll_clickable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item13" />

                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item2"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/common_select_tips" />

                                <ImageView
                                    android:layout_width="@dimen/x18"
                                    android:layout_height="@dimen/x18"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="@dimen/x10"
                                    android:clickable="false"
                                    android:src="@mipmap/ic_click_down" />

                            </RelativeLayout>

                            <LinearLayout
                                android:id="@+id/ll_scan"
                                android:layout_width="@dimen/x60"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/x10"
                                android:background="@drawable/button_purple"
                                android:gravity="center">

                                <ImageView
                                    style="@style/BtnImgStyle"
                                    android:layout_marginRight="0dp"
                                    android:src="@mipmap/ic_scan" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item14" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item3"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>


                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_output_item8" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item4"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:layout_weight="1.5"
                                    android:background="@null"
                                    android:hint="@string/common_input_tips"
                                    android:inputType="numberDecimal" />

                                <View
                                    android:layout_width="@dimen/x1"
                                    android:layout_height="@dimen/x18"
                                    android:background="@color/white" />


                                <RelativeLayout
                                    android:id="@+id/rl_jldw"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_jldw"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_marginRight="@dimen/x20"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:gravity="center"
                                        android:text="吨" />

                                    <ImageView
                                        android:id="@+id/iv_jldw"
                                        android:layout_width="@dimen/x18"
                                        android:layout_height="@dimen/x18"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginHorizontal="@dimen/x10"
                                        android:clickable="false"
                                        android:src="@mipmap/ic_click_down" />

                                </RelativeLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_output_item2" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item5"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item3" />

                            <RelativeLayout
                                android:id="@+id/ll_item3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item6"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/common_select_scan_tips" />

                                <ImageView
                                    android:layout_width="@dimen/x18"
                                    android:layout_height="@dimen/x18"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="@dimen/x10"
                                    android:clickable="false"
                                    android:src="@mipmap/ic_click_down" />

                            </RelativeLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item6" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item7"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </RelativeLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item4" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item8"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item5" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item9"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item7" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item10"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item11" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext_disable"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item11"
                                    style="@style/EditTextStyle3"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:enabled="false" />

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item15" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item12"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/common_select_tips" />

                                <ImageView
                                    android:layout_width="@dimen/x18"
                                    android:layout_height="@dimen/x18"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="@dimen/x10"
                                    android:clickable="false"
                                    android:src="@mipmap/ic_click_down" />

                            </RelativeLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item16" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item13"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/common_select_tips" />

                                <ImageView
                                    android:layout_width="@dimen/x18"
                                    android:layout_height="@dimen/x18"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="@dimen/x10"
                                    android:clickable="false"
                                    android:src="@mipmap/ic_click_down" />

                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_P">


                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item12" />


                                <com.grkj.ytjqy_pad.utils.view.AddNumberView
                                    android:id="@+id/add_view"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:gravity="center" />


                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_output_item21" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item14"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/common_select_tips" />

                                <ImageView
                                    android:layout_width="@dimen/x18"
                                    android:layout_height="@dimen/x18"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="@dimen/x10"
                                    android:clickable="false"
                                    android:src="@mipmap/ic_click_down" />

                            </RelativeLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout style="@style/FormLayoutStyle_P">

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_input_item17" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_edittext"
                                android:gravity="left|center">

                                <com.grkj.ytjqy_pad.utils.popwindow.spinner.HistorySearchSpinner
                                    android:id="@+id/et_item15"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    app:hint="@string/common_input_select_tips" />


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_C">

                            <TextView
                                style="@style/FormTitleStyle"
                                android:text="@string/str_output_item18" />

                            <LinearLayout style="@style/SearchSpinnerLayoutStyle">

                                <com.grkj.ytjqy_pad.utils.popwindow.spinner.SearchSpinner
                                    android:id="@+id/et_item16"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="10dp"
                                    app:hint="@string/str_loading" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.grkj.ytjqy_pad.utils.view.MyLinearLayout>

            </LinearLayout>

        </com.grkj.ytjqy_pad.utils.view.GrScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="@dimen/x10"
        android:focusable="true"
        android:gravity="center|bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_save"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:background="@drawable/button_style2">

            <ImageView
                style="@style/BtnImgStyle"
                android:src="@mipmap/ic_save_white" />

            <TextView
                style="@style/BtnFontStyle"
                android:text="保存" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_delete"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:background="@drawable/button_style4"
            android:visibility="gone">

            <ImageView
                style="@style/BtnImgStyle"
                android:src="@mipmap/ic_cancel_white" />

            <TextView
                style="@style/BtnFontStyle"
                android:text="删除" />

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/x10"
        android:focusable="true"
        android:gravity="center|bottom"
        android:orientation="horizontal">


        <LinearLayout
            android:id="@+id/ll_print"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:background="@drawable/button_style1"
            android:visibility="gone">

            <ImageView
                style="@style/BtnImgStyle"
                android:src="@mipmap/ic_get_label" />

            <TextView
                style="@style/BtnFontStyle"
                android:text="生成标签" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_copy"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:background="@drawable/button_style5"
            android:visibility="gone">

            <ImageView
                style="@style/BtnImgStyle"
                android:src="@mipmap/ic_copy_white" />

            <TextView
                style="@style/BtnFontStyle"
                android:text="复制" />

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/x10"
        android:focusable="true"
        android:gravity="center|bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_check"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:layout_marginLeft="@dimen/x10"
            android:background="@drawable/button_style2"
            android:visibility="gone">

            <ImageView
                style="@style/BtnImgStyle"
                android:src="@mipmap/ic_hand_white" />

            <TextView
                android:id="@+id/tv_check"
                style="@style/BtnFontStyle"
                android:layout_marginLeft="@dimen/x5"
                android:padding="0dp"
                android:text="校准" />


        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_handle"
            style="@style/BottomBtnStyle"
            android:layout_marginHorizontal="@dimen/x20"
            android:background="@drawable/button_style3"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_handle"
                style="@style/BtnFontStyle"
                android:layout_marginLeft="@dimen/x5"
                android:padding="0dp"
                android:text="委外利用" />

            <ImageView
                android:layout_width="@dimen/x18"
                android:layout_height="@dimen/x18"
                android:src="@mipmap/ic_menu_right" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
