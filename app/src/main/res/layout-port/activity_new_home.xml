<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_login"
    android:gravity="center_horizontal"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/x10"
        android:gravity="left|center"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/x10"
        android:paddingHorizontal="@dimen/x20">

        <ImageView
            android:id="@+id/login_logo_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/x10"
            android:src="@mipmap/ic_login_top_logo" />

        <TextView
            android:id="@+id/app_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x20"
            android:text="@string/app_title"
            android:textColor="@color/white"
            android:textSize="@dimen/x28"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_right"
            style="@style/Font15Style"
            android:layout_weight="1"
            android:gravity="right"
            android:text="2022年3月15日 星期二" />


    </LinearLayout>


    <LinearLayout
        android:gravity="center"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/x70">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/ll_menu1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x210"
                android:layout_margin="@dimen/x10"
                android:background="@mipmap/bg_home_menu1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/x10">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x100"
                        android:layout_centerInParent="true"
                        android:src="@mipmap/ic_home_menu1" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x80"
                        android:text="产废登记" />


                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x110"
                        android:text="PRODUCTION WASTE"
                        android:textSize="@dimen/x15" />

                </RelativeLayout>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x90"
                android:id="@+id/ll_menu4"
                android:layout_margin="@dimen/x10"
                android:background="@mipmap/bg_home_menu2"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/x10">


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/iv_menu4"
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_marginTop="@dimen/x20"
                        android:src="@mipmap/ic_home_menu4" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_toRightOf="@id/iv_menu4"
                        android:text="系统设置" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x40"
                        android:layout_toRightOf="@id/iv_menu4"
                        android:text="SETTING"
                        android:textSize="@dimen/x15" />

                </RelativeLayout>


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/ll_menu2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x130"
                android:layout_margin="@dimen/x10"
                android:background="@mipmap/bg_home_menu2"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/x10">


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/x10">

                    <ImageView
                        android:id="@+id/iv_menu2"
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_marginTop="@dimen/x20"
                        android:src="@mipmap/ic_home_menu2" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_toRightOf="@id/iv_menu2"
                        android:text="入库登记" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x40"
                        android:layout_toRightOf="@id/iv_menu2"
                        android:text="INPUT"
                        android:textSize="@dimen/x15" />

                </RelativeLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <RelativeLayout
                    android:id="@+id/ll_menu5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/x170"
                    android:layout_margin="@dimen/x10"
                    android:layout_weight="1"
                    android:background="@mipmap/bg_home_menu4"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/x10">

                    <ImageView
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="@dimen/x30"
                        android:src="@mipmap/ic_home_menu5" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x90"
                        android:text="视频监控" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x120"
                        android:text="VIDEO"
                        android:textSize="@dimen/x15" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ll_menu6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/x170"
                    android:layout_margin="@dimen/x10"
                    android:layout_weight="1"
                    android:background="@mipmap/bg_home_menu5"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/x10">

                    <ImageView
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="@dimen/x30"
                        android:src="@mipmap/ic_home_menu6" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x90"
                        android:text="企业台账" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x120"
                        android:text="LEDGER"
                        android:textSize="@dimen/x15" />


                </RelativeLayout>


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/ll_menu3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x130"
                android:layout_margin="@dimen/x10"
                android:background="@mipmap/bg_home_menu3"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/x5">


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/x10">

                    <ImageView
                        android:id="@+id/iv_menu3"
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_marginTop="@dimen/x20"
                        android:src="@mipmap/ic_home_menu3" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_toRightOf="@id/iv_menu3"
                        android:text="出库登记" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x40"
                        android:layout_toRightOf="@id/iv_menu3"
                        android:text="OUTPUT"
                        android:textSize="@dimen/x15" />

                </RelativeLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <RelativeLayout
                    android:id="@+id/ll_menu7"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/x170"
                    android:layout_margin="@dimen/x10"
                    android:layout_weight="1"
                    android:background="@mipmap/bg_home_menu2"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/x10">

                    <ImageView
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="@dimen/x30"
                        android:src="@mipmap/ic_home_menu7" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x90"
                        android:text="库存统计" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x120"
                        android:text="STATISTICS"
                        android:textSize="@dimen/x15" />


                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/ll_menu8"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/x170"
                    android:layout_margin="@dimen/x10"
                    android:layout_weight="1"
                    android:background="@mipmap/bg_home_menu6"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/x10">

                    <ImageView
                        android:layout_width="@dimen/x70"
                        android:layout_height="@dimen/x70"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="@dimen/x30"
                        android:src="@mipmap/ic_home_menu8" />

                    <TextView
                        style="@style/Font24Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x90"
                        android:text="数据上报" />

                    <TextView
                        style="@style/Font15Style"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/x120"
                        android:text="REPORTED"
                        android:textSize="@dimen/x15" />


                </RelativeLayout>


            </LinearLayout>


        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="@dimen/x30"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_company"
            style="@style/Font10Style"
            android:text="@string/str_support" />

        <TextView
            android:id="@+id/mVersion"
            style="@style/Font10Style"
            android:layout_marginLeft="@dimen/x10"
            android:text="当前版本:V1.0.0" />

    </LinearLayout>


</LinearLayout>
