<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <include
        layout="@layout/view_toolbar_new"
        android:visibility="gone" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/x20"
            android:visibility="gone">

            <View
                android:layout_width="@dimen/x5"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_style_primary" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Font15Style"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="新增废物信息" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginRight="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/x18"
                    android:layout_height="@dimen/x18"
                    android:src="@mipmap/ic_add" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="新增" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginLeft="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x18"
                    android:layout_height="@dimen/x18"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>


        </LinearLayout>


        <com.grkj.ytjqy_pad.utils.view.GrScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/x10">

                <com.grkj.ytjqy_pad.utils.view.MyLinearLayout
                    android:id="@+id/ll_clickable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                        <LinearLayout style="@style/FormLayoutStyle_P">

                            <LinearLayout style="@style/FormLayoutStyle_C">


                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item2" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item2"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_select_tips" />

                                    <ImageView
                                        android:layout_width="@dimen/x18"
                                        android:layout_height="@dimen/x18"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginHorizontal="@dimen/x10"
                                        android:clickable="false"
                                        android:src="@mipmap/ic_click_down" />

                                </RelativeLayout>


                            </LinearLayout>

                            <LinearLayout style="@style/FormLayoutStyle_C">

                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item1" />

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext_disable"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item1"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_select_tips" />


                                </RelativeLayout>


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_P">

                            <LinearLayout style="@style/FormLayoutStyle_C">

                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item3" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext_disable"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item3"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_select_tips" />


                                </RelativeLayout>


                            </LinearLayout>

                            <LinearLayout style="@style/FormLayoutStyle_C">

                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item4" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext_disable"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item4"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_select_tips" />


                                </RelativeLayout>


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_P">

                            <LinearLayout style="@style/FormLayoutStyle_C">

                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item5" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext_disable"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item5"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_select_tips" />

                                </RelativeLayout>


                            </LinearLayout>

                            <LinearLayout style="@style/FormLayoutStyle_C">


                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item6" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext_disable"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item6"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_select_tips" />


                                </RelativeLayout>


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout style="@style/FormLayoutStyle_P">

                            <LinearLayout style="@style/FormLayoutStyle_C">

                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item7" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext_disable"
                                    android:gravity="left|center">

                                    <EditText
                                        android:id="@+id/et_item7"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/common_input_tips" />


                                </RelativeLayout>


                            </LinearLayout>

                            <LinearLayout style="@style/FormLayoutStyle_C">

                                <TextView
                                    style="@style/FormTitleStyle_200"
                                    android:text="@string/str_collect_info_child_item9" />


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext"
                                    android:gravity="left|center">

                                    <!--                                <EditText-->
                                    <!--                                    android:id="@+id/et_item9"-->
                                    <!--                                    style="@style/EditTextStyle3"-->
                                    <!--                                    android:layout_width="match_parent"-->
                                    <!--                                    android:layout_gravity="center"-->
                                    <!--                                    android:background="@null"-->
                                    <!--                                    android:focusableInTouchMode="false"-->
                                    <!--                                    android:hint="@string/common_select_tips" />-->

                                    <!--                                <ImageView-->
                                    <!--                                    android:layout_width="@dimen/x18"-->
                                    <!--                                    android:layout_height="@dimen/x18"-->
                                    <!--                                    android:layout_alignParentRight="true"-->
                                    <!--                                    android:layout_centerVertical="true"-->
                                    <!--                                    android:layout_marginHorizontal="@dimen/x10"-->
                                    <!--                                    android:clickable="false"-->
                                    <!--                                    android:src="@mipmap/ic_click_down" />-->

                                    <EditText
                                        android:id="@+id/et_item9"
                                        style="@style/EditTextStyle3"
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:background="@null"
                                        android:hint="@string/common_input_tips" />


                                </RelativeLayout>


                            </LinearLayout>


                        </LinearLayout>


                </com.grkj.ytjqy_pad.utils.view.MyLinearLayout>


                <LinearLayout style="@style/FormLayoutStyle_P">

                    <LinearLayout style="@style/FormLayoutStyle_C">


                        <TextView
                            style="@style/FormTitleStyle_200"
                            android:text="@string/str_collect_info_child_item8" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_edittext"
                            android:gravity="left|center">

                            <EditText
                                android:id="@+id/et_item8"
                                style="@style/EditTextStyle3"
                                android:layout_gravity="center"
                                android:layout_weight="1.2"
                                android:background="@null"
                                android:gravity="center"
                                android:hint="@string/common_input_tips"
                                android:inputType="numberDecimal" />

                            <View
                                android:layout_width="@dimen/x1"
                                android:layout_height="match_parent"
                                android:background="@color/colorFontB" />


                            <RelativeLayout
                                android:id="@+id/rl_jldw"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="left|center">

                                <EditText
                                    android:id="@+id/et_item17"
                                    style="@style/EditTextStyle3"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:layout_marginRight="@dimen/x20"
                                    android:background="@null"
                                    android:focusableInTouchMode="false"
                                    android:gravity="center"
                                    android:hint="@string/common_input_tips"
                                    android:text="吨" />

                                <ImageView
                                    android:id="@+id/iv_jldw"
                                    android:layout_width="@dimen/x18"
                                    android:layout_height="@dimen/x18"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="@dimen/x10"
                                    android:src="@mipmap/ic_click_down" />

                            </RelativeLayout>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:id="@+id/ll_get_weight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/x40"
                                    android:layout_marginLeft="@dimen/x5"
                                    android:background="@drawable/button_style1"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="@dimen/x8"
                                    android:visibility="gone">

                                    <ImageView
                                        android:layout_width="@dimen/x15"
                                        android:layout_height="@dimen/x15"
                                        android:src="@mipmap/ic_fresh" />

                                    <TextView
                                        style="@style/Font10Style"
                                        android:layout_marginLeft="@dimen/x5"
                                        android:padding="0dp"
                                        android:text="重新称重"
                                        android:textColor="@color/white"
                                        android:visibility="gone" />

                                </LinearLayout>


                            </FrameLayout>


                        </LinearLayout>


                    </LinearLayout>


                    <LinearLayout
                        style="@style/FormLayoutStyle_C"
                        android:visibility="gone">


                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>


        </com.grkj.ytjqy_pad.utils.view.GrScrollView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginVertical="@dimen/x10"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_save"
                style="@style/BottomBtnStyle"
                android:layout_marginHorizontal="@dimen/x20"
                android:background="@drawable/button_style2">

                <ImageView
                    style="@style/BtnImgStyle"
                    android:src="@mipmap/ic_save_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:text="保存" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_delete"
                style="@style/BottomBtnStyle"
                android:layout_marginHorizontal="@dimen/x20"
                android:background="@drawable/button_style4"
                android:visibility="gone">

                <ImageView
                    style="@style/BtnImgStyle"
                    android:src="@mipmap/ic_cancel_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:text="删除" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x10"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_print"
                style="@style/BottomBtnStyle"
                android:layout_marginHorizontal="@dimen/x20"
                android:background="@drawable/button_style1"
                android:visibility="gone">

                <ImageView
                    style="@style/BtnImgStyle"
                    android:src="@mipmap/ic_get_label" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:text="生成标签" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_copy"
                style="@style/BottomBtnStyle"
                android:layout_marginHorizontal="@dimen/x20"
                android:background="@drawable/button_style5"
                android:visibility="gone">

                <ImageView
                    style="@style/BtnImgStyle"
                    android:src="@mipmap/ic_copy_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:text="复制" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x10"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_handle"
                style="@style/BottomBtnStyle"
                android:layout_marginHorizontal="@dimen/x20"
                android:background="@drawable/button_style3"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_handle"
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="委外利用" />

                <ImageView
                    android:layout_width="@dimen/x18"
                    android:layout_height="@dimen/x18"
                    android:src="@mipmap/ic_menu_right" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:visibility="gone">


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_right_bottom1"
                style="@style/Font10Style"
                android:text="当前第一页" />


            <TextView
                android:id="@+id/tv_right_bottom2"
                style="@style/Font10Style"
                android:text="共5页，共30条" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_left_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x30"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.grkj.ytjqy_pad.utils.view.BoldTextView
                android:id="@+id/tv_left_bottom"
                style="@style/Font24Style"
                android:text="2.999" />


            <TextView
                style="@style/Font10Style"
                android:text="合计产生(吨)" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>
