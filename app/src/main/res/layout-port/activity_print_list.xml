<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">


    <include layout="@layout/view_toolbar" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/x10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x20"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/x15">


                <com.grkj.ytjqy_pad.utils.view.InputSelectView
                    android:id="@+id/isv_fwxxmc"
                    android:layout_width="0dp"
                    app:hint="废物详细名称"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/x15"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:id="@+id/ll_fwxxmc"
                    android:layout_height="@dimen/x52"
                    android:layout_marginRight="@dimen/x15"
                    android:background="@drawable/bg_edittext"
                    android:visibility="gone"
                    android:layout_gravity="start"
                    android:gravity="left|center">

                    <EditText
                        android:id="@+id/et_fwxxmc"
                        style="@style/EditTextStyle3"
                        android:gravity="start"
                        android:layout_marginHorizontal="0dp"
                        android:layout_width="match_parent"
                        android:textSize="@dimen/x15"
                        android:padding="@dimen/x5"
                        android:layout_gravity="center"
                        android:hint="输入废物详细名称"
                        android:background="@null" />


                </LinearLayout>



                <com.grkj.ytjqy_pad.utils.view.InputSelectView
                    android:id="@+id/isv_djlx"
                    app:hint="登记类型"
                    app:enabled="false"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <com.grkj.ytjqy_pad.utils.view.SelectTimeView
                    android:id="@+id/v_select_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/x15"
                    android:layout_marginVertical="@dimen/x10"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/ll_search_click"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x40"
                    android:layout_marginLeft="@dimen/x10"
                    android:layout_marginRight="@dimen/x15"
                    android:background="@drawable/button_green2"
                    android:gravity="center">

                    <ImageView
                        style="@style/BtnImgStyle"
                        android:layout_marginRight="0dp"
                        android:src="@mipmap/ic_search" />


                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:layout_marginLeft="@dimen/x15"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_home_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="主页" />


            </LinearLayout>


        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/x10">

        <com.scwang.smartrefresh.layout.SmartRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.grkj.ytjqy_pad.utils.view.GrRecyclerView
                android:id="@+id/mRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/x10" />

        </com.scwang.smartrefresh.layout.SmartRefreshLayout>


    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:background="@mipmap/bg_logo_bottom"
        android:visibility="gone">


        <LinearLayout
            android:id="@+id/ll_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x60"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x30"
            android:layout_marginBottom="@dimen/x5"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_right_bottom1"
                style="@style/Font12Style"
                android:text="当前第一页"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tv_right_bottom2"
                style="@style/Font12Style"
                android:layout_gravity="center"
                android:text="共1页，共0条" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="@dimen/x150"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_left_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.grkj.ytjqy_pad.utils.view.BoldTextView
                    android:id="@+id/tv_left_bottom"
                    style="@style/Font24Style"
                    android:maxLines="1"
                    android:text="0.000"
                    android:textColor="@color/colorFontOrange"
                    android:textSize="@dimen/x18" />


                <TextView
                    android:id="@+id/tv_left_bottom2"
                    style="@style/Font10Style"
                    android:text="入库(吨)" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_left_bottom2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:layout_toRightOf="@+id/ll_left_bottom"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.grkj.ytjqy_pad.utils.view.BoldTextView
                    android:id="@+id/tv_left_bottom3"
                    style="@style/Font24Style"
                    android:maxLines="1"
                    android:text="0.000"
                    android:textColor="@color/colorFontOrange"
                    android:textSize="@dimen/x18" />


                <TextView
                    android:id="@+id/tv_left_bottom4"
                    style="@style/Font10Style"
                    android:text="出库(吨)" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/x30"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/ll_back"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x28"
                android:background="@drawable/button_style1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/x12"
                    android:layout_height="@dimen/x12"
                    android:src="@mipmap/ic_back_white" />

                <TextView
                    style="@style/BtnFontStyle"
                    android:layout_marginLeft="@dimen/x5"
                    android:padding="0dp"
                    android:text="返回" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                style="@style/Font10Style"
                android:text="@string/str_support" />

            <TextView
                android:id="@+id/mVersion"
                style="@style/Font10Style"
                android:layout_marginLeft="@dimen/x10"
                android:text="当前版本:V1.0.0" />

        </LinearLayout>


    </RelativeLayout>


</LinearLayout>
