<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="#ffffff"
    android:paddingTop="22dp"
    android:id="@+id/mMainLayout"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!--        android:background="@drawable/button_style_line_black2"-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">


                    <!-- 废物名称 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item1"
                                style="@style/ContentFontStyle10x10"
                                android:text="废物名称1" />

                        </LinearLayout>


                    </LinearLayout>



                    <!-- 废物类别 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item2"
                                style="@style/ContentFontStyle10x10"
                                android:text="废物类别2" />

                        </LinearLayout>




                    </LinearLayout>




                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:id="@+id/ll_fwdm"
                        android:orientation="horizontal">

                        <!-- 废物代码 -->
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:id="@+id/tv_item3"
                            android:textSize="22dp"
                            style="@style/ContentFontStyle10x10"
                            android:text="废物代码3" />


                        <!-- 废物形态 -->
                        <TextView
                            android:id="@+id/tv_item6"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            style="@style/RightContentFontStyle10x10"
                            android:gravity="top"
                            android:text="废物形态4" />


                    </LinearLayout>


                    <!-- 主要成分 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/ll_zycf"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item8"
                                style="@style/MulContentFontStyle10x10"
                                android:text="123" />


                        </LinearLayout>



                    </LinearLayout>



                    <!-- 有害成分 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item9"
                                android:minLines="2"
                                style="@style/MulContentFontStyle10x10"
                                android:text="123" />



                        </LinearLayout>




                    </LinearLayout>


                </LinearLayout>




                <LinearLayout
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginBottom="20dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="70dp"
                    android:layout_height="match_parent">



                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_gravity="left"
                        android:gravity="left"
                        android:layout_weight="1"
                        android:layout_height="0dp">


                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="10dp">


                            <CheckBox
                                android:id="@+id/cb_dx"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="10dp"
                                android:textColor="#333" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">


                            <CheckBox
                                android:id="@+id/cb_fyx"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:layout_marginRight="12dp"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="10dp"
                                android:textColor="#333" />
                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="0dp">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:paddingHorizontal="10dp"
                            android:layout_weight="1"
                            android:layout_height="120dp">


                            <CheckBox
                                android:id="@+id/cb_yrx"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="10dp"
                                android:textColor="#333" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="5dp"
                            android:layout_height="120dp">


                            <CheckBox
                                android:id="@+id/cb_fsx"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginRight="12dp"
                                android:layout_centerHorizontal="true"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="10dp"
                                android:textColor="#333" />

                        </RelativeLayout>

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>





            <!-- 注意事项 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item10"
                    style="@style/MulContentFontStyle10x10"
                    android:text="321" />


            </LinearLayout>



            <!-- 数字识别码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/ll_qrcode"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:id="@+id/tv_item11"
                    android:textSize="22dp"
                    style="@style/ContentFontStyle10x10"
                    android:text="数字识别码8" />


            </LinearLayout>




            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:id="@+id/ll_bottom"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <!-- 产生/收集单位 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="0dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="50dp"
                            android:layout_height="0dp"/>

                        <TextView
                            android:id="@+id/tv_item12"
                            style="@style/ContentFontStyle10x10"
                            android:text="产生/收集单位9" />


                    </LinearLayout>



                    <!-- 联系人和联系方式10 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <View
                            android:layout_width="100dp"
                            android:layout_height="0dp"/>

                        <TextView
                            android:id="@+id/tv_item14"
                            style="@style/ContentFontStyle10x10"
                            android:text="联系人和联系方式10" />


                    </LinearLayout>




                    <!-- 产生日期、产生量 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/tv_item4"
                            android:layout_width="0dp"
                            android:textSize="20dp"
                            android:layout_weight="1"
                            style="@style/ContentFontStyle10x10"
                            android:text="2023-06-07" />


                        <TextView
                            android:id="@+id/tv_item5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            style="@style/RightContentFontStyle10x10"
                            android:gravity="top"
                            android:text="0.112吨" />



                    </LinearLayout>




                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="0dp"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/tv_item16"
                            android:textSize="18dp"
                            android:lines="2"
                            style="@style/RightContentFontStyle10x10"
                            android:text="备注备注备注备注备注备注备注备注" />


                    </LinearLayout>



                </LinearLayout>

                <LinearLayout
                    android:gravity="left"
                    android:layout_gravity="left"
                    android:layout_weight="1"
                    android:layout_marginRight="40dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_code"
                        android:src="@mipmap/ic_code_test"
                        android:layout_gravity="left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </LinearLayout>


            </LinearLayout>

            <TextView
                android:id="@+id/tv_item7"
                style="@style/ContentFontStyle10x10"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item13"
                style="@style/ContentFontStyle10x10"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item15"
                android:visibility="gone"
                style="@style/ContentFontStyle10x10" />

        </LinearLayout>


    </LinearLayout>


</LinearLayout>