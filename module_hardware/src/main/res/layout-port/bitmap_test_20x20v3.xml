<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="#ffffff"
    android:paddingTop="@dimen/x90"
    android:id="@+id/mMainLayout"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!--        android:background="@drawable/button_style_line_black2"-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">


                    <!-- 废物名称 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item1"
                                style="@style/ContentFontStyle20x20v3"
                                android:text="废物名称1" />

                        </LinearLayout>


                    </LinearLayout>



                    <!-- 废物类别 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item2"
                                style="@style/ContentFontStyle20x20v3"
                                android:text="废物类别2" />

                        </LinearLayout>


                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:orientation="horizontal">

                        <!-- 废物代码 -->
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:textSize="@dimen/x20"
                            android:id="@+id/tv_item3"
                            android:layout_marginRight="5dp"
                            style="@style/ContentFontStyle20x20v3"
                            android:text="废物代码3" />


                        <!-- 废物形态 -->
                        <TextView
                            android:id="@+id/tv_item6"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            style="@style/RightContentFontStyle20x20v3"
                            android:gravity="top"
                            android:text="废物形态4" />


                    </LinearLayout>


                    <!-- 主要成分 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/x92"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item8"
                                style="@style/MulContentFontStyle20x20v3"
                                android:text="主要成分" />


                        </LinearLayout>



                    </LinearLayout>



                    <!-- 有害成分 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/x92"
                            android:layout_weight="1"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/tv_item9"
                                android:minLines="2"
                                style="@style/MulContentFontStyle20x20v3"
                                android:text="有害成分" />


                        </LinearLayout>




                    </LinearLayout>


                </LinearLayout>




                <LinearLayout
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginBottom="@dimen/x20"
                    android:layout_marginRight="@dimen/x30"
                    android:layout_marginLeft="@dimen/x10"
                    android:layout_marginTop="@dimen/x70"
                    android:layout_height="match_parent">



                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_gravity="left"
                        android:gravity="left"
                        android:layout_weight="1"
                        android:layout_height="0dp">


                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/x5">


                            <CheckBox
                                android:id="@+id/cb_dx"
                                android:layout_width="@dimen/x20"
                                android:layout_height="@dimen/x20"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="@dimen/x5"
                                android:textColor="#333" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">


                            <CheckBox
                                android:id="@+id/cb_fyx"
                                android:layout_centerHorizontal="true"
                                android:layout_width="@dimen/x20"
                                android:layout_height="@dimen/x20"
                                android:layout_alignParentBottom="true"
                                android:layout_marginRight="4dp"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="@dimen/x5"
                                android:textColor="#333" />
                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="0dp">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:paddingHorizontal="@dimen/x5"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">


                            <CheckBox
                                android:id="@+id/cb_yrx"
                                android:layout_width="@dimen/x20"
                                android:layout_height="@dimen/x20"
                                android:layout_centerHorizontal="true"
                                android:layout_alignParentBottom="true"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="@dimen/x5"
                                android:textColor="#333" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/x5"
                            android:layout_height="wrap_content">


                            <CheckBox
                                android:id="@+id/cb_fsx"
                                android:layout_width="@dimen/x20"
                                android:layout_centerHorizontal="true"
                                android:layout_height="@dimen/x20"
                                android:layout_alignParentBottom="true"
                                android:background="@mipmap/ic_unchecked_black"
                                android:button="@null"
                                android:padding="@dimen/x5"
                                android:textColor="#333" />

                        </RelativeLayout>

                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>





            <!-- 注意事项 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginRight="@dimen/x20"
                android:layout_height="@dimen/x92"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item10"
                    style="@style/MulContentFontStyle20x20v3"
                    android:text="有害成分" />


            </LinearLayout>



            <!-- 数字识别码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/x30"
                    android:layout_height="0dp"/>

                <TextView
                    android:id="@+id/tv_item11"
                    android:layout_marginRight="@dimen/x20"
                    android:layout_marginBottom="@dimen/x10"
                    style="@style/ContentFontStyle20x20v3"
                    android:textSize="@dimen/x18"
                    android:text="数字识别码" />



            </LinearLayout>




            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <!-- 产生/收集单位 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="0dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/x60"
                            android:layout_height="0dp"/>

                        <TextView
                            android:id="@+id/tv_item12"
                            android:textSize="@dimen/x14"
                            style="@style/ContentFontStyle20x20v3"
                            android:text="收集单位/产生单位" />


                    </LinearLayout>



                    <!-- 联系人和联系方式10 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <View
                            android:layout_width="@dimen/x110"
                            android:layout_height="0dp"/>

                        <TextView
                            android:id="@+id/tv_item14"
                            style="@style/ContentFontStyle20x20v3"
                            android:text="联系人和联系方式" />


                    </LinearLayout>




                    <!-- 产生日期、产生量 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/tv_item4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textSize="@dimen/x22"
                            style="@style/ContentFontStyle20x20v3"
                            android:text="2023-06-07" />


                        <TextView
                            android:id="@+id/tv_item5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            style="@style/RightContentFontStyle20x20v3"
                            android:gravity="top"
                            android:text="0.112吨" />



                    </LinearLayout>




                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_weight="1.1"
                        android:layout_height="0dp"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/tv_item16"
                            style="@style/RightContentFontStyle20x20v3"
                            android:textSize="@dimen/x16"
                            android:layout_gravity="left|center"
                            android:text="备注" />


                    </LinearLayout>



                </LinearLayout>

                <LinearLayout
                    android:gravity="left"
                    android:layout_gravity="left"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_marginRight="@dimen/x15"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_code"
                        android:src="@mipmap/ic_code_test"
                        android:layout_gravity="left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </LinearLayout>


            </LinearLayout>

            <TextView
                android:id="@+id/tv_item7"
                style="@style/ContentFontStyle20x20v3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item13"
                style="@style/ContentFontStyle20x20v3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item15"
                android:visibility="gone"
                style="@style/ContentFontStyle20x20v3" />

        </LinearLayout>


    </LinearLayout>


</LinearLayout>