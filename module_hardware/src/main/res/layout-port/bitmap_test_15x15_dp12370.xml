<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:id="@+id/mMainLayout"
    android:orientation="vertical"
    android:paddingTop="110dp"
    android:paddingLeft="130dp"
    tools:ignore="MissingDefaultResource">

    <!--  16dp  -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="245dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <!-- 废物名称 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/tv_item1"
                        style="@style/ContentFontStyle15x15Dp12370"
                        android:text="废物名称1废物名称1废物名称1废物名称1废物名称1废物名称1废物名称1废物名称1废物名称1" />

                </LinearLayout>


            </LinearLayout>


            <!-- 废物类别 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/tv_item2"
                        style="@style/ContentFontStyle15x15Dp12370"
                        android:text="废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2废物类别2" />

                </LinearLayout>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:gravity="left"
                android:orientation="horizontal">

                <!-- 废物代码 -->
                <TextView
                    android:id="@+id/tv_item3"
                    style="@style/ContentFontStyle15x15Dp12370"
                    android:layout_width="0dp"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:text="废物代码3废物代码3废物代码3" />


                <!-- 废物形态 -->
                <TextView
                    android:id="@+id/tv_item6"
                    style="@style/RightContentFontStyle15x15Dp12370"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="top"
                    android:text="废物形态4废物形态4废物形态4废物形态4" />


            </LinearLayout>


            <!-- 主要成分 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tv_item8"
                    style="@style/MulContentFontStyle15x15Dp12370"
                    android:text="主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分主要成分" />


            </LinearLayout>


            <!-- 有害成分 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item9"
                    style="@style/MulContentFontStyle15x15Dp12370"
                    android:minLines="2"
                    android:text="有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分有害成分" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingTop="30dp"
            android:paddingRight="16dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:gravity="left"
                android:orientation="horizontal">


                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="5dp">


                    <CheckBox
                        android:id="@+id/cb_dx"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@mipmap/ic_unchecked_black"
                        android:button="@null"
                        android:padding="5dp"
                        android:textColor="#333" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="5dp">


                    <CheckBox
                        android:id="@+id/cb_fyx"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@mipmap/ic_unchecked_black"
                        android:button="@null"
                        android:padding="5dp"
                        android:textColor="#333" />
                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="5dp">


                    <CheckBox
                        android:id="@+id/cb_yrx"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@mipmap/ic_unchecked_black"
                        android:button="@null"
                        android:padding="5dp"
                        android:textColor="#333" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="5dp">


                    <CheckBox
                        android:id="@+id/cb_fsx"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@mipmap/ic_unchecked_black"
                        android:button="@null"
                        android:padding="5dp"
                        android:textColor="#333" />

                </RelativeLayout>

            </LinearLayout>


        </LinearLayout>


    </LinearLayout>


    <!-- 注意事项 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginRight="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item10"
            style="@style/MulContentFontStyle15x15Dp12370"
            android:text="注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项注意事项" />


    </LinearLayout>


    <!-- 数字识别码 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginRight="20dp"
        android:id="@+id/ll_item11"
        android:orientation="horizontal">

        <View
            android:layout_width="20dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_item11"
            style="@style/ContentFontStyle15x15Dp12370"
            android:text="数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8数字识别码8" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <!-- 产生/收集单位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="40dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/tv_item12"
                    style="@style/ContentFontStyle15x15Dp12370"
                    android:text="产生/收集单位9产生/收集单位9产生/收集单位9产生/收集单位9产生/收集单位9产生/收集单位9产生/收集单位9" />


            </LinearLayout>


            <!-- 联系人和联系方式10 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="80dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/tv_item14"
                    style="@style/ContentFontStyle15x15Dp12370"
                    android:text="联系人和联系方式10联系人和联系方式10联系人和联系方式10联系人和联系方式10联系人和联系方式10联系人和联系方式10联系人和联系方式10" />


            </LinearLayout>


            <!-- 产生日期、产生量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tv_item4"
                    style="@style/ContentFontStyle15x15Dp12370"
                    android:layout_width="0dp"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:text="2023-06-07" />


                <TextView
                    android:id="@+id/tv_item5"
                    style="@style/RightContentFontStyle15x15Dp12370"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="top"
                    android:text="0.112吨" />


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:paddingLeft="-20dp"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tv_item16"
                    android:textSize="10dp"
                    android:maxLines="2"
                    style="@style/ContentFontStyle15x15Dp12370"
                    android:text="备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注" />


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/iv_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:src="@mipmap/ic_code_test" />

        </LinearLayout>


    </LinearLayout>


</LinearLayout>